# Porta su cui l'app risponde sul tuo computer (http://localhost:PORT).
# Nel container l'app ascolta sempre sulla 3000: la mappatura la fa docker-compose.
PORT=3000

# Database. Con docker-compose DB_HOST e DB_PORT sono impostati automaticamente
# (host "db", porta 5432): questi due valori servono solo se avvii l'app fuori da Docker.
# DB_NAME, DB_USER e DB_PASSWORD sono usati sia da Postgres sia dall'app.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grafo
DB_USER=postgres
# Cambia la password prima di usare il progetto: questo valore è solo un segnaposto.
DB_PASSWORD=change_me

# Chiave privata RS256 in formato PEM su una riga, con le newline scritte come \n
# e il valore tra virgolette, per esempio: JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Generala con "npm run keys" (oppure docker compose run --rm --no-deps app npm run keys)
# o con openssl, come spiegato nel README. Non committare mai il valore reale.
JWT_PRIVATE_KEY=

# Coefficiente della media esponenziale, 0 < ALPHA < 1 (se errato si usa 0.9)
ALPHA=0.9